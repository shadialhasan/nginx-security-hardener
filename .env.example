# Nginx Security Hardener Configuration
DEFAULT_DOMAIN=example.enterprise.com
DEFAULT_PORT=3000

# Rate Limiting Presets: strict (10r/s burst=20), standard (30r/s burst=50), relaxed (100r/s burst=150), off
RATE_LIMIT_PRESET=standard

# Security Presets: strict (A+ rating, tight CSP, COOP/CORP), standard (balanced), relaxed
SECURITY_PRESET=strict

# Client body limit
CLIENT_MAX_BODY_SIZE=50m

# WebSocket proxy support
ENABLE_WEBSOCKET=true
